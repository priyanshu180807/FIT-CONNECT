# Local default; set APP_ENV=production in the deployed backend environment.
APP_ENV=development

# Generate a unique random value of at least 32 characters; never commit the real value.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Comma-separated allowed browser origins, without paths or trailing slashes.
CORS_ORIGINS=http://localhost:5173

# Supabase PostgreSQL connection string (pooler / transaction mode).
# Local development leaves this unset to use the built-in SQLite fallback.
# Production: set this in the Vercel backend project environment variables.
# Example: postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=
