# Set APP_ENV=production in the deployed backend environment.
APP_ENV=production

# Generate a unique random value of at least 32 characters; never commit the real value.
JWT_SECRET_KEY=replace_with_a_unique_random_secret_at_least_32_characters

# Comma-separated allowed browser origins, without paths or trailing slashes.
CORS_ORIGINS=https://your-frontend-domain.example.com

# Use a managed, persistent MySQL database in production. Keep credentials in the
# hosting provider's secret manager, not in Git. URL-encode special characters.
DATABASE_URL=mysql+pymysql://fitconnect_user:replace_me@your-db-host.example.com:3306/fitconnect_db?charset=utf8mb4
