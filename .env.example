# =========================================================================
# Backend settings (used by FastAPI, never exposed to the frontend)
# =========================================================================
# Set to "production" on Vercel; leave "development" locally.
APP_ENV=development

# Supabase PostgreSQL connection string (pooler / transaction mode).
# Leave empty for local development to use the built-in SQLite fallback.
# Production: set this in the Vercel backend project environment variables.
DATABASE_URL=

# A random secret of at least 32 characters for signing JWT tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Comma-separated allowed frontend origins (no trailing slashes).
CORS_ORIGINS=http://localhost:5173

# =========================================================================
# Frontend build-time setting (safe to expose; contains no secrets)
# =========================================================================
# Local Vite dev server defaults to http://localhost:8000.
# In the Vercel frontend project, set this to the deployed backend HTTPS URL.
VITE_API_URL=http://localhost:8000
